# Project Talon v2 - Environment Variables
# Copy this file to .env and fill in your values

# ─── LLM Providers ───────────────────────────────────────────────────────────

# Anthropic (Claude) — used when provider: "anthropic" in agents.yaml
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — used when provider: "openai" in agents.yaml
OPENAI_API_KEY=sk-...

# Google Gemini — used when provider: "gemini" in agents.yaml
GEMINI_API_KEY=...

# Local LLM (LM Studio / Ollama / vLLM) — used when provider: "local"
# LM Studio default:  http://localhost:1234/v1
# Ollama default:     http://localhost:11434/v1
# vLLM default:       http://localhost:8080/v1
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_API_KEY=lm-studio
LOCAL_LLM_MODEL=llama-3.2-3b-instruct

# ─── Microsoft Teams Bot Framework (optional) ────────────────────────────────
# Set both values to enable the Teams bot surface.
# Keep SKIP_SIGNATURE_VERIFICATION=false for deployed environments.
# Use SKIP_SIGNATURE_VERIFICATION=true only for local webhook testing.
TEAMS_APP_ID=                    # Azure Bot App ID
TEAMS_APP_PASSWORD=              # Azure Bot App Secret (client secret)

# ─── Jira (optional) ─────────────────────────────────────────────────────────
# Modes:
#   disabled -> tool returns a clear disabled message
#   mock     -> demo-only fake Jira responses
#   live     -> real Jira REST API calls
JIRA_MODE=disabled
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ─── GitHub Issues (optional) ────────────────────────────────────────────────
# Modes:
#   disabled -> tool returns a clear disabled message
#   mock     -> demo-only fake GitHub issue responses
#   live     -> real GitHub Issues REST API calls
GITHUB_MODE=disabled
GITHUB_TOKEN=
GITHUB_REPO=

# ─── ServiceNow (optional) ───────────────────────────────────────────────────
# Modes:
#   disabled -> tool returns a clear disabled message
#   mock     -> demo-only fake ServiceNow ticket responses
#   live     -> real ServiceNow Table API calls
SERVICENOW_MODE=disabled
SERVICENOW_BASE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_TABLE=incident

# ─── MCP Servers (optional) ──────────────────────────────────────────────────
# Configure stdio MCP servers as JSON. Example:
# MCP_SERVERS_JSON={"filesystem":{"transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}}
# MCP tools are exposed to agents through tool grants like:
#   mcp:*             -> all discovered MCP tools
#   mcp:filesystem:*  -> all tools from one MCP server
#   mcp:filesystem:read_file -> one specific MCP tool
MCP_SERVERS_JSON=
MCP_TOOL_TIMEOUT=30

# ─── Policy Engine (optional) ────────────────────────────────────────────────
# Use POLICY_ENGINE=opa to evaluate policy decisions through an external OPA
# server with Rego. Keep POLICY_ENGINE=legacy for the in-process evaluator.
POLICY_ENGINE=legacy
OPA_BASE_URL=
OPA_FAIL_MODE=closed

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///talon.db

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins.
# Example production value:
# CORS_ORIGINS=https://talon-webchat.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001

# Required to access /api/employees/*, /api/dashboard/*, and /api/audit/*
ADMIN_API_TOKEN=change-me

# ─── Optional ────────────────────────────────────────────────────────────────
SKIP_SIGNATURE_VERIFICATION=false
# RELOAD=true                        # Hot-reload for development
